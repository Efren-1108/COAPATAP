# =====================================================
# Sistema de Control de Activos Fijos
# Archivo .gitignore
# =====================================================

# PHP / logs
*.log
logs/
!logs/.gitkeep

# Uploads (fotos de activos) — están en public/uploads/
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/index.html

# Entorno
.env
.env.local
config/config.local.php

# Sistema
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Dependencias
vendor/
node_modules/
